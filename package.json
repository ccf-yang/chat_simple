{
  "name": "openai-chat-desktop",
  "version": "1.0.0",
  "description": "OpenAI 兼容接口聊天桌面客户端，支持自定义 Base URL / API Key / Model，多会话 Tab，流式输出",
  "main": "./out/main/index.js",
  "author": "monkeycode-ai",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "build:win:portable": "electron-vite build && electron-builder --win --x64 portable",
    "build:linux": "electron-vite build && electron-builder --linux --x64"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "marked": "^15.0.4",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.2.0"
  }
}
